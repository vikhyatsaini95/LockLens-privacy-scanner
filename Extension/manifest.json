{
  "manifest_version": 3,
  "name": "LockLens",
  "version": "1.1",
  "description": "Privacy-first digital footprint awareness and privacy warning tool.",
  "action": {
    "default_title": "LockLens Privacy Scanner",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "scripts/privacyGuard.js"
      ],
      "css": [
      "scripts/privacyGuard.css"
      ],
      "run_at": "document_idle"
    }
  ]
}